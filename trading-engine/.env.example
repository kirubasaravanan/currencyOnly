# Local secrets — gitignored, never commit the real .env.
#
# OANDA is READ-ONLY: it only ever fetches candles for signal generation
# and backtesting. Deliberately no OANDA_ACCOUNT_ID anywhere in this repo
# — order-placement endpoints require one, so leaving it out is a
# structural guarantee, not just a policy, that OANDA specifically can
# never be used to place a real order from this app.
OANDA_API_TOKEN=

# Discord webhook — entry/exit/session/EOD trade alerts only (engine/discord_alerts.py).
DISCORD_WEBHOOK_URL=

# TradeSgnl relay (engine/tradesgnl_relay.py) — OPTIONAL, REAL order
# execution to whatever MT5 account this license is registered to. Leave
# TRADESGNL_LICENSE_ID blank (the default) to keep this app pure paper-
# only, with no order-placement code path active anywhere. Only set this
# once you've deliberately verified which account this specific license
# routes to — see engine/tradesgnl_relay.py's module docstring.
TRADESGNL_LICENSE_ID=
TRADESGNL_WEBHOOK_URL=https://webhook.tradesgnl.com

# PineConnector relay (engine/pineconnector_relay.py) — OPTIONAL, a SECOND
# independent real order-execution connection running alongside TradeSgnl,
# not a replacement for it. Same convention: leave PINECONNECTOR_LICENSE_ID
# blank to keep this connection fully inert. No known default webhook URL
# — must be set per account. Verify PineConnector's actual command grammar
# against a real test-fire before trusting this on anything beyond a demo
# — see engine/pineconnector_relay.py's module docstring.
PINECONNECTOR_LICENSE_ID=
PINECONNECTOR_WEBHOOK_URL=

# Real-account source for the daily give-back breaker (engine/
# real_giveback_source.py) — OPTIONAL, READ-ONLY (never places or closes
# anything itself). Points at the FundedNext challenge account that will
# replace the PineConnector demo login on the Secondary MT5 terminal.
# Leave FUNDEDNEXT_MT5_LOGIN blank/0 to keep the give-back breaker fully
# dormant (it returns "no data" every cycle and never triggers) — same
# convention as every other credential in this file. Only the login needs
# setting explicitly; the terminal path already defaults to the Secondary
# MT5 install per the account-swap plan, override only if that changes.
FUNDEDNEXT_MT5_TERMINAL_PATH=
FUNDEDNEXT_MT5_LOGIN=

# Discord bot listener (engine/discord_bot_listener.py) — OPTIONAL, a
# manual "close everything on both real accounts right now" command typed
# in Discord, independent of the give-back breaker. Needs a real Discord
# BOT (not the webhook above — a webhook can't receive messages). Leave
# DISCORD_BOT_TOKEN blank to keep this fully inert, same convention as
# every other credential in this file.
#
# Setup (one-time, on discord.com/developers/applications):
#   1. New Application -> Bot -> Reset Token, copy it -> DISCORD_BOT_TOKEN.
#   2. Under Bot -> Privileged Gateway Intents, enable "Message Content
#      Intent" (required — the bot can't read command text without it).
#   3. OAuth2 -> URL Generator: scope "bot", permissions "Read Messages/View
#      Channels" + "Send Messages". Open the generated URL, invite the bot
#      to the same server your DISCORD_WEBHOOK_URL alerts already post to.
#   4. Discord -> User Settings -> Advanced -> enable Developer Mode, then
#      right-click your own username -> Copy User ID -> DISCORD_AUTHORIZED_USER_ID.
#      Only messages from this exact user ID are ever acted on — everyone
#      else typing the command is silently ignored.
#
# Commands (type in any channel the bot can see):
#   !closeall  -- close every open real position right now, entries resume
#                 normally afterward.
#   !stopday   -- close every open real position AND pause new real
#                 entries (both accounts) for the rest of today.
DISCORD_BOT_TOKEN=
DISCORD_AUTHORIZED_USER_ID=
