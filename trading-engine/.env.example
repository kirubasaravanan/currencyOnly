# Local secrets — gitignored, never commit the real .env.
#
# This app is READ-ONLY against OANDA: it fetches candles for signal
# generation and backtesting, and never places, modifies, or closes an
# order anywhere. Deliberately no OANDA_ACCOUNT_ID anywhere in this repo —
# order-placement endpoints require one, so leaving it out is a structural
# guarantee, not just a policy, that this app cannot touch a real account.
OANDA_API_TOKEN=

# Discord webhook — entry/exit/session/EOD trade alerts only (engine/discord_alerts.py).
DISCORD_WEBHOOK_URL=
